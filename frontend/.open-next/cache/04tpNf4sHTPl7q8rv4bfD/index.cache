{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/,_N_T_/index"},"segmentPaths":["/_tree","/_full","/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":160,"slots":null}}}},"html":"<!DOCTYPE html><html lang=\"en\" data-scroll-behavior=\"smooth\" class=\"geist_a71539c9-module__T19VSG__variable ibm_plex_mono_c2b95734-module__6MIMDG__variable h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/23b7a97ae3b5c134-s.p.226pwps5o-gq_.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/a7e15459c1805da0-s.p.3y9b8znjr2455.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/caa3a2e1cccd8315-s.p.0wgildi0cnwt9.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/effe91970fc4db64-s.p.0oace-s_gkfks.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/projects/makevideosmall/cover.png\" as=\"image\"/><link rel=\"preload\" href=\"/projects/ciphersprint/cover.png\" as=\"image\"/><link rel=\"preload\" href=\"/projects/gaberina/cover.png\" as=\"image\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2tt0xv3r6ez1q.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/3yfl9fgvivx3-.js\"/><script src=\"/_next/static/chunks/11jq0c2_zavac.js\" async=\"\"></script><script src=\"/_next/static/chunks/1j_9b-l0n6u-t.js\" async=\"\"></script><script src=\"/_next/static/chunks/0mh0ufarzeu14.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2_9m89bpqsmb_.js\" async=\"\"></script><script src=\"/_next/static/chunks/2x08av3tugl6j.js\" async=\"\"></script><script src=\"/_next/static/chunks/2-sht-ns7yqzv.js\" async=\"\"></script><script src=\"/_next/static/chunks/0okg82rqpcvuv.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><meta name=\"theme-color\" content=\"#fafafa\" media=\"(prefers-color-scheme: light)\"/><meta name=\"theme-color\" content=\"#09090b\" media=\"(prefers-color-scheme: dark)\"/><title>Sahiljeet Singh Kalsi — Full-Stack Engineer</title><meta name=\"description\" content=\"Full-stack engineer working across Node.js, NestJS, TypeScript, PostgreSQL, Redis, and AWS. I&#x27;ve cut cloud infrastructure costs by 40% through query and network optimization, and shipped multiple products end-to-end, from backend to deployment, often leaning on AI tooling to move faster.\"/><meta name=\"application-name\" content=\"Sahiljeet Singh Kalsi Portfolio\"/><link rel=\"author\" href=\"https://sahiljeet.dev\"/><meta name=\"author\" content=\"Sahiljeet Singh Kalsi\"/><link rel=\"manifest\" href=\"/manifest.webmanifest\"/><meta name=\"keywords\" content=\"Sahiljeet Singh Kalsi,Full-Stack Engineer,Backend Developer,Distributed Systems,Cloud Optimization,Node.js,NestJS,TypeScript,PostgreSQL,Redis,AWS,Next.js,Software Engineer Portfolio\"/><meta name=\"creator\" content=\"Sahiljeet Singh Kalsi\"/><meta name=\"publisher\" content=\"Sahiljeet Singh Kalsi\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><meta name=\"category\" content=\"technology\"/><link rel=\"canonical\" href=\"https://sahiljeet.dev\"/><meta property=\"og:title\" content=\"Sahiljeet Singh Kalsi — Full-Stack Engineer\"/><meta property=\"og:description\" content=\"Full-stack engineer working across Node.js, NestJS, TypeScript, PostgreSQL, Redis, and AWS. I&#x27;ve cut cloud infrastructure costs by 40% through query and network optimization, and shipped multiple products end-to-end, from backend to deployment, often leaning on AI tooling to move faster.\"/><meta property=\"og:url\" content=\"https://sahiljeet.dev\"/><meta property=\"og:site_name\" content=\"Sahiljeet Singh Kalsi Portfolio\"/><meta property=\"og:locale\" content=\"en_US\"/><meta property=\"og:image\" content=\"https://sahiljeet.dev/og-default.png\"/><meta property=\"og:image:type\" content=\"image/png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Sahiljeet Singh Kalsi — Full-Stack Engineer\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:creator\" content=\"@ghostofweb\"/><meta name=\"twitter:title\" content=\"Sahiljeet Singh Kalsi — Full-Stack Engineer\"/><meta name=\"twitter:description\" content=\"Full-stack engineer working across Node.js, NestJS, TypeScript, PostgreSQL, Redis, and AWS. I&#x27;ve cut cloud infrastructure costs by 40% through query and network optimization, and shipped multiple products end-to-end, from backend to deployment, often leaning on AI tooling to move faster.\"/><meta name=\"twitter:image\" content=\"https://sahiljeet.dev/og-default.png\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.12d-8c7fbugc9.ico\" sizes=\"32x32\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/favicon-16x16.png\" sizes=\"16x16\" type=\"image/png\"/><link rel=\"icon\" href=\"/favicon-32x32.png\" sizes=\"32x32\" type=\"image/png\"/><link rel=\"icon\" href=\"/icon-192.png\" sizes=\"192x192\" type=\"image/png\"/><link rel=\"icon\" href=\"/icon-512.png\" sizes=\"512x512\" type=\"image/png\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\" sizes=\"180x180\" type=\"image/png\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full bg-bg text-text\"><div hidden=\"\"><!--$--><!--/$--></div><script>((a,b,c,d,e,f,g,h)=>{let i=document.documentElement,j=[\"light\",\"dark\"];function k(b){var c;(Array.isArray(a)?a:[a]