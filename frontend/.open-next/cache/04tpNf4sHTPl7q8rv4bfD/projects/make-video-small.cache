 name=\"twitter:title\" content=\"Make Video Small | Sahiljeet Singh Kalsi\"/><meta name=\"twitter:description\" content=\"A desktop app for high-efficiency video compression, providing a clean interface over FFmpeg and Av1an.\"/><meta name=\"twitter:image\" content=\"https://sahiljeet.dev/projects/makevideosmall/cover.png\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.12d-8c7fbugc9.ico\" sizes=\"32x32\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/favicon-16x16.png\" sizes=\"16x16\" type=\"image/png\"/><link rel=\"icon\" href=\"/favicon-32x32.png\" sizes=\"32x32\" type=\"image/png\"/><link rel=\"icon\" href=\"/icon-192.png\" sizes=\"192x192\" type=\"image/png\"/><link rel=\"icon\" href=\"/icon-512.png\" sizes=\"512x512\" type=\"image/png\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\" sizes=\"180x180\" type=\"image/png\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full bg-bg text-text\"><div hidden=\"\"><!--$--><!--/$--></div><script>((a,b,c,d,e,f,g,h)=>{let i=document.documentElement,j=[\"light\",\"dark\"];function k(b){var c;(Array.isArray(a)?a:[a]).forEach(a=>{let c=\"class\"===a,d=c&&f?e.map(a=>f[a]||a):e;c?(i.classList.remove(...d),i.classList.add(f&&f[b]?f[b]:b)):i.setAttribute(a,b)}),c=b,h&&j.includes(c)&&(i.style.colorScheme=c)}if(d)k(d);else try{let a=localStorage.getItem(b)||c,d=g&&\"system\"===a?window.matchMedia(\"(prefers-color-scheme: dark)\").matches?\"dark\":\"light\":a;k(d)}catch(a){}})(\"data-theme\",\"theme\",\"light\",null,[\"light\",\"dark\"],null,false,true)</script><div class=\"mx-auto max-w-2xl px-6 pb-24 pt-16 sm:pt-20\"><a class=\"text-sm text-text-muted transition-colors hover:text-accent\" href=\"/#projects\">← Back to projects</a><article class=\"mt-6\"><div class=\"flex items-center gap-3\"><span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-border bg-bg-elevated\"><img alt=\"\" loading=\"lazy\" width=\"20\" height=\"20\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fassets%2Fproject-logo6.png&amp;w=32&amp;q=75 1x, /_next/image?url=%2Fassets%2Fproject-logo6.png&amp;w=48&amp;q=75 2x\" src=\"/_next/image?url=%2Fassets%2Fproject-logo6.png&amp;w=48&amp;q=75\"/></span><h1 class=\"font-serif text-2xl font-semibold text-text sm:text-3xl\">Make Video Small</h1></div><p class=\"mt-4 max-w-xl text-base leading-relaxed text-text\">Make Video Small wraps local AV1 encoding in a desktop app so shrinking video doesn&#x27;t mean learning FFmpeg flags. It batches an entire folder, reads your own CPU and GPU to propose a sensible preset, previews the result against the source before committing to a real encode, and never uploads a single file.</p><div class=\"mt-4 flex flex-wrap items-center gap-3\"><a href=\"https://makevideosmall.vercel.app/\" target=\"_blank\" rel=\"noreferrer\" class=\"inline-flex items-center gap-1 rounded-full border border-accent bg-accent px-3.5 py-1.5 text-sm font-medium text-bg transition-opacity hover:opacity-90\">Visit live site<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-3.5 w-3.5\" aria-hidden=\"true\"><path d=\"M7 17 17 7\"></path><path d=\"M8 7h9v9\"></path></svg></a><div class=\"flex flex-wrap gap-2\"><span class=\"rounded-full border border-border bg-bg-elevated px-2.5 py-0.5 text-xs text-text-muted\">Electron</span><span class=\"rounded-full border border-border bg-bg-elevated px-2.5 py-0.5 text-xs text-text-muted\">React.js</span><span class=\"rounded-full border border-border bg-bg-elevated px-2.5 py-0.5 text-xs text-text-muted\">Node.js</span><span class=\"rounded-full border border-border bg-bg-elevated px-2.5 py-0.5 text-xs text-text-muted\">Python</span></div></div><div><div class=\"mt-10 flex flex-col gap-8\"><figure><img src=\"/projects/makevideosmall/01-hero.png\" alt=\"Local AV1 encoding for Windows: drop in files and batch-compress without uploading anything.\" loading=\"lazy\" class=\"w-full cursor-zoom-in rounded-xl border border-border object-cover shadow-sm\"/><figcaption class=\"mt-2 text-sm text-text-muted\">Local AV1 encoding for Windows: drop in files and batch-compress without uploading anything.</figcaption></figure><figure><img src=\"/projects/makevideosmall/02-proof.png\" alt=\"A draggable before/after comparison with real SSIM and PSNR numbers, not a marketing estimate.\" loading=\"lazy\" class=\"w-full cursor-zoom-in rounded-xl border border-border object-cover shadow-sm\"/><figcaption class=\"mt-2 text-sm text-text-muted\">A draggable before/after comparison with real SSIM and PSNR numbers, not a marketing estimate.</figcaption></figure><figure><img src=\"/projects/makevideosmall/03-preview-studio.png\" alt=\"Visual Preview Studio previews every quality preset against the source before the real encode runs.\" loading=\"lazy\" class=\"w-full cursor-zoom-in rounded-xl border border-border object-cover shadow-sm\"/><figcaption class=\"mt-2 text-sm text-text-muted\">Visual Preview Studio previews every quality preset against the source before the real encode runs.</figcaption></figure><figure><img src=\"/projects/makevideosmall/04-how-it-works.png\" alt=\"Three steps: drop a folder, let it read your hardware, walk away.\" loading=\"lazy\" class=\"w-full cursor-zoom-in rounded-xl border border-border object-cover shadow-sm\"/><figcaption class=\"mt-2 text-sm text-text-muted\">Three steps: drop a folder, let it read your hardware, walk away.</figcaption></figure><figure><img src=\"/projects/makevideosmall/05-features.png\" alt=\"Built for people with too many files: full hardware use, nothing leaves the disk, no ceiling.\" loading=\"lazy\" class=\"w-full cursor-zoom-in rounded-xl border border-border object-cover shadow-sm\"/><figcaption class=\"mt-2 text-sm text-text-muted\">Built for people with too many files: full hardware use, nothing leaves the disk, no ceiling.</figcaption></figure><figure><img src=\"/projects/makevideosmall/06-image-studio.png\" alt=\"Handles stills too, with AI upscaling and a metadata studio for EXIF cleanup.\" loading=\"lazy\" class=\"w-full cursor-zoom-in rounded-xl border border-border object-cover shadow-sm\"/><figcaption class=\"mt-2 text-sm text-text-muted\">Handles stills too, with AI upscaling and a metadata studio for EXIF cleanup.</figcaption></figure><figure><img src=\"/projects/makevideosmall/07-compare.png\" alt=\"An honest comparison table against the alternatives, including where it doesn&#x27;t win.\" loading=\"lazy\" class=\"w-full cursor-zoom-in rounded-xl border border-border object-cover shadow-sm\"/><figcaption class=\"mt-2 text-sm text-text-muted\">An honest comparison table against the alternatives, including where it doesn&#x27;t win.</figcaption></figure></div></div></article></div><!--$--><!--/$--><section class=\"Toastify\" aria-live=\"polite\" aria-atomic=\"false\" aria-relevant=\"additions text\" aria-label=\"Notifications Alt+T\"></section><script src=\"/_next/static/chunks/3yfl9fgvivx3-.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[65150,[\\\"/_next/static/chunks/2x08av3tugl6j.js\\\"],\\\"default\\\"]\\n3:I[39756,[\\\"/_next/static/chunks/2x08av3tugl6j.js\\\"],\\\"default\\\"]\\n4:I[37457,[\\\"/_next/static/chunks/2x08av3tugl6j.js\\\"],\\\"default\\\"]\\n5:I[70319,[\\\"/_next/static/chunks/2x08av3tugl6j.js\\\"],\\\"ToastContainer\\\"]\\n7:I[97367,[\\\"/_next/static/chunks/2x08av3tugl6j.js\\\"],\\\"OutletBoundary\\\"]\\n8:\\\"$Sreact.suspense\\\"\\nb:I[97367,[\\\"/_next/static/chunks/2x08av3tugl6j.js\\\"],\\\"ViewportBoundary\\\"]\\nd:I[97367,[\\\"/_next/static/chunks/2x08av3tugl6j.js\\\"],\\\"MetadataBoundary\\\"]\\nf:I[68027,[\\\"/_next/static/chunks/2x08av3tugl6j.js\\\"],\\\